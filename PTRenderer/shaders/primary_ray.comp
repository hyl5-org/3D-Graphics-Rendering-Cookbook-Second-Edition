//

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_flags_primitive_culling : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 out_FragColor;

layout(std430, buffer_reference) readonly buffer LightBuffer
{
    mat4 viewProjBias;
    vec4 lightDir;
    uint frameIndex;
};

layout(push_constant) uniform PushConstants
{
    mat4 invViewProj;
    uint sceneColor;
    uint gbuffer1;
    uint gbuffer2;
    uint gbuffer3;
    uint depth;
    uint texSkyboxIrradiance;
    uint texRTShadowAO;
    uint smpl;
    LightBuffer light;
}
pc;

f16vec2 signNotZero16(f16vec2 v)
{
    return f16vec2(v.x >= float16_t(0.0) ? float16_t(1.0) : float16_t(-1.0),
                   v.y >= float16_t(0.0) ? float16_t(1.0) : float16_t(-1.0));
}

vec3 decodeOctahedron(vec2 e)
{
    f16vec2 f = f16vec2(e) * float16_t(2.0) - float16_t(1.0);
    f16vec3 n = f16vec3(f.x, f.y, float16_t(1.0) - abs(f.x) - abs(f.y));
    if (n.z < float16_t(0.0))
    {
        n.xy = (float16_t(1.0) - abs(n.yx)) * signNotZero16(n.xy);
    }
    return normalize(vec3(n));
}

vec3 reconstructWorldPosition(vec2 uv, float depth)
{
    vec2 ndc = uv * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
    vec4 world = pc.invViewProj * vec4(ndc, depth, 1.0);
    return world.xyz / world.w;
}

void main()
{
    f16vec3 scene = f16vec3(textureBindless2D(pc.sceneColor, pc.smpl, uv).rgb);
    float depth = textureBindless2D(pc.depth, pc.smpl, uv).r;
    if (depth >= 0.9999)
    {
        out_FragColor = vec4(vec3(scene), 1.0);
        return;
    }

    f16vec4 g1 = f16vec4(textureBindless2D(pc.gbuffer1, pc.smpl, uv));
    // vec4 g2 = textureBindless2D(pc.gbuffer2, pc.smpl, uv);
    f16vec4 g3 = f16vec4(textureBindless2D(pc.gbuffer3, pc.smpl, uv));

    vec3 n = decodeOctahedron(vec2(g1.xy));
    // float metallic = g2.x;
    // float specular = g2.y;
    // float roughness = max(g2.z, 0.04);
    f16vec3 baseColor = g3.rgb;
    // float ao = g3.a;

    vec3 worldPos = reconstructWorldPosition(uv, depth);
    float shadowVisibility = 1.0;
    float ao = float(g3.a);
    vec4 shadowCoords = pc.light.viewProjBias * vec4(worldPos, 1.0);

    vec3 l = -normalize(pc.light.lightDir.xyz);
    float16_t nDotL = float16_t(max(dot(n, l), 0.0));

    vec3 sky = vec3(-n.x, n.y, -n.z);
    f16vec3 ibl = f16vec3(textureBindlessCube(pc.texSkyboxIrradiance, 0, sky).rgb);

    // PBR-ish path kept for later:
    // vec3 diffuseColor = baseColor * (1.0 - metallic);
    // vec3 direct = diffuseColor * max(dot(n, l), 0.0) * shadowVisibility;
    // vec3 iblPbr = textureBindlessCube(pc.texSkyboxIrradiance, 0, sky).rgb * diffuseColor * ao;
    // vec3 v = vec3(0.0, 0.0, 1.0);
    // vec3 h = normalize(l + v);
    // float specPower = mix(96.0, 4.0, roughness);
    // float specTerm = pow(max(dot(n, h), 0.0), specPower) * specular * shadowVisibility;
    // vec3 f0 = mix(vec3(0.04), baseColor, metallic);

    const f16vec3 f0 = f16vec3(0.04);
    f16vec3 diffuseAlbedo = baseColor * (f16vec3(1.0) - f0);
    f16vec3 indirectDiffuse = ibl * diffuseAlbedo * float16_t(clamp(ao, 0.0, 1.0));
    f16vec3 directDiffuse = f16vec3(nDotL) * diffuseAlbedo * float16_t(shadowVisibility);
    f16vec3 color = scene + indirectDiffuse + directDiffuse;
    out_FragColor = vec4(vec3(color), 1.0);
}
