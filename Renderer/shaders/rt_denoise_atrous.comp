//

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform texture2D kTextures2D[];
layout(set = 0, binding = 1) uniform sampler kSamplers[];
layout(set = 0, binding = 2, rg8) uniform writeonly image2D kTextures2DOut[];

vec4 textureBindless2D(uint textureid, uint smpl, vec2 uv)
{
    return textureLod(nonuniformEXT(sampler2D(kTextures2D[textureid], kSamplers[smpl])), uv, 0);
}

ivec2 textureBindlessSize2D(uint textureid)
{
    return textureSize(nonuniformEXT(kTextures2D[textureid]), 0);
}

layout(constant_id = 0) const uint kStep = 1u;

const vec2 kCrossOffsets[4] = vec2[](vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0));

const vec2 kDiagonalOffsets[4] = vec2[](vec2(1.0, 1.0), vec2(-1.0, 1.0), vec2(1.0, -1.0), vec2(-1.0, -1.0));

layout(push_constant) uniform PushConstants
{
    uint texIn;
    uint texOut;
    uint texDepth;
    uint texGBuffer1;
    uint smpl;
    float depthSigma;
    float normalSigma;
}
pc;

/*
