float edgeWeight(float centerDepth, float sampleDepth, vec2 centerNormalOct, vec2 sampleNormalOct)
{
    f16vec2 normalDiff = f16vec2(sampleNormalOct - centerNormalOct);
    float depthWeight = exp2(-abs(sampleDepth - centerDepth) / max(pc.depthSigma, 1e-6));
    // skip normal decode
    float16_t normalWeight = exp2(-dot(normalDiff, normalDiff) * float16_t(pc.normalSigma));
    return depthWeight * float(normalWeight);
}

float edgeWeightFast(float centerDepth, float sampleDepth)
{
    return exp2(-abs(sampleDepth - centerDepth) / max(pc.depthSigma, 1e-6));
}

void main()
{
    ivec2 size = textureBindlessSize2D(pc.texIn);
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);

    if (xy.x >= size.x || xy.y >= size.y)
    {
        return;
    }

    vec2 uv = (vec2(xy) + vec2(0.5)) / vec2(size);
    vec2 texelSize = vec2(1.0) / vec2(size);

    f16vec2 centerColor = f16vec2(textureBindless2D(pc.texIn, pc.smpl, uv).rg);
    float centerDepth = textureBindless2D(pc.texDepth, pc.smpl, uv).r;
    // vec2 centerNormalOct = textureBindless2D(pc.texGBuffer1, pc.smpl, uv).xy;

    vec2 stepTexel = texelSize * float(kStep);

    f16vec2 sumColor = centerColor * 0.5hf;
    float totalWeight = 0.5;

    // Rotated sparse 5-tap: pass 1 uses cross taps, pass 2 uses diagonal taps.
    for (int i = 0; i < 4; ++i)
    {
        vec2 offset = (kStep == 1u ? kCrossOffsets[i] : kDiagonalOffsets[i]) * stepTexel;
        vec2 sampleUV = uv + offset;
        f16vec2 sampleColor = f16vec2(textureBindless2D(pc.texIn, pc.smpl, sampleUV).rg);
        float sampleDepth = textureBindless2D(pc.texDepth, pc.smpl, sampleUV).r;
        // Normal weighting costs about 0.2 ms on mobile with no obvious visual gain over depth-only weighting.
        // vec2 sampleNormalOct = textureBindless2D(pc.texGBuffer1, pc.smpl, sampleUV).xy;

        // float w = 0.125 * edgeWeight(centerDepth, sampleDepth, centerNormalOct, sampleNormalOct);
        float w = 0.125 * edgeWeightFast(centerDepth, sampleDepth);
        sumColor += sampleColor * float16_t(w);
        totalWeight += w;
    }

    f16vec2 result = totalWeight > 0.001 ? sumColor / float16_t(totalWeight) : centerColor;
    imageStore(kTextures2DOut[pc.texOut], xy, vec4(result, 0.0hf, 1.0hf));
}
