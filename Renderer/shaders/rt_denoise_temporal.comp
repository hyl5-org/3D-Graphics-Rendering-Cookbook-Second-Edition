//

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform texture2D kTextures2D[];
layout(set = 0, binding = 1) uniform sampler kSamplers[];
layout(set = 0, binding = 2, rg8) uniform writeonly image2D kTextures2DOut[];

vec4 textureBindless2D(uint textureid, uint smpl, vec2 uv)
{
    return textureLod(nonuniformEXT(sampler2D(kTextures2D[textureid], kSamplers[smpl])), uv, 0);
}

ivec2 textureBindlessSize2D(uint textureid)
{
    return textureSize(nonuniformEXT(kTextures2D[textureid]), 0);
}

layout(push_constant) uniform PushConstants
{
    mat4 invViewProj;
    mat4 prevViewProj;
    uint texCurrent;
    uint texHistory;
    uint texDepth;
    uint texPrevDepth;
    uint texOut;
    uint smpl;
    float alpha;
    float depthThreshold;
}
pc;

vec3 reconstructWorldPosition(vec2 uv, float depth)
{
    vec2 ndc = uv * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
    vec4 world = pc.invViewProj * vec4(ndc, depth, 1.0);
    return world.xyz / world.w;
}

vec2 reprojectToPrevUV(vec3 worldPos)
{
    vec4 prevClip = pc.prevViewProj * vec4(worldPos, 1.0);
    vec2 prevNDC = prevClip.xy / prevClip.w;
    return prevNDC * vec2(0.5, -0.5) + vec2(0.5, 0.5);
}

void main()
{
    ivec2 size = textureBindlessSize2D(pc.texCurrent);
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);

    if (xy.x >= size.x || xy.y >= size.y)
    {
        return;
    }

    vec2 uv = (vec2(xy) + vec2(0.5)) / vec2(size);

    f16vec2 current = f16vec2(textureBindless2D(pc.texCurrent, pc.smpl, uv).rg);

    float depth = textureBindless2D(pc.texDepth, pc.smpl, uv).r;

    if (depth >= 0.9999)
    {
        imageStore(kTextures2DOut[pc.texOut], xy, vec4(1.0, 1.0, 0.0, 1.0));
        return;
    }

    vec3 worldPos = reconstructWorldPosition(uv, depth);
    vec2 prevUV = reprojectToPrevUV(worldPos);

    const float margin = 2.0 / float(size.x);
    bool valid = all(greaterThan(prevUV, vec2(margin))) && all(lessThan(prevUV, vec2(1.0 - margin)));

    if (valid)
    {
        float prevFrameDepth = textureBindless2D(pc.texPrevDepth, pc.smpl, prevUV).r;
        vec4 prevClip = pc.prevViewProj * vec4(worldPos, 1.0);
        float expectedDepth = prevClip.z / prevClip.w;
        if (abs(expectedDepth - prevFrameDepth) > pc.depthThreshold)
        {
            valid = false;
        }
    }

    // neighborhood min/max clamping (3x3) in fp16
    f16vec2 nMin = current;
    f16vec2 nMax = current;
    vec2 texelSize = vec2(1.0) / vec2(size);
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            f16vec2 s = f16vec2(textureBindless2D(pc.texCurrent, pc.smpl, uv + vec2(dx, dy) * texelSize).rg);
            nMin = min(nMin, s);
            nMax = max(nMax, s);
        }
    }

    f16vec2 result;
    if (valid)
    {
        f16vec2 history = f16vec2(textureBindless2D(pc.texHistory, pc.smpl, prevUV).rg);
        // TODO(luhanyang): This may destabilize temporal accumulation for shadow/AO.
        history = clamp(history, nMin, nMax);
        // EMA: result = history * (1 - alpha) + current * alpha
        result = mix(history, current, float16_t(pc.alpha));
    }
    else
    {
        result = current;
    }

    imageStore(kTextures2DOut[pc.texOut], xy, vec4(result, 0.0hf, 1.0hf));
}
